# Response headers for Cloudflare Pages and Netlify.
#
# GitHub Pages IGNORES this file (it has no header support) — the current
# production host therefore serves no security headers at all. It takes effect
# when the hosting moves to Cloudflare Pages, as planned in
# docs/hosting/migration-github-pages-to-cdn.md.
#
# CSP NOTE: script-src/style-src keep 'unsafe-inline' because the app depends on
# inline <script> blocks (bootstrap detection, boot sentinel, SW registration)
# and generated inline onerror handlers. Removing it requires hashing or
# refactoring those first. The directives below are the ones that can be locked
# down today with no risk of breaking the app, and they are what actually
# contain an XSS or injection: object-src and base-uri kill base-tag/script
# gadget chains, frame-ancestors stops clickjacking, form-action stops credential
# exfiltration via injected forms.
#
# img-src must include https://*.supabase.co: uploaded listing photos are served
# from the Supabase Storage public bucket (listing-photos). Without it every
# uploaded photo downloads but is refused by the browser and shows as broken.
# tradersgag6.github.io covers listings whose photos still point at the old
# GitHub Pages host.

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Permissions-Policy: geolocation=(self), camera=(), microphone=(), payment=(), usb=()
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob: https://*.supabase.co https://tradersgag6.github.io https://images.unsplash.com https://*.basemaps.cartocdn.com https://*.tile.openstreetmap.org; connect-src 'self' https://*.supabase.co https://esrealty-market-scan.vercel.app; frame-src https://www.google.com; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; form-action 'self'

# Fingerprinted, immutable-ish assets. The app shell must never be cached stale.
/index.html
  Cache-Control: no-cache, must-revalidate

/js/app.min.js
  Cache-Control: public, max-age=0, must-revalidate

/css/*
  Cache-Control: public, max-age=0, must-revalidate

/vendor/*
  Cache-Control: public, max-age=604800

/sw.js
  Cache-Control: no-cache, must-revalidate

/data/*
  Cache-Control: public, max-age=3600

# The calculator's settings (building rates, bands, version). A pricing change must
# reach every visitor on their next load, not up to an hour later.
/data/zonal-config.json
  ! Cache-Control
  Cache-Control: no-cache
